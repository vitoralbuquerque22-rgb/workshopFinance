{
  "description": "Sincroniza\u00e7\u00e3o di\u00e1ria autom\u00e1tica de boletos DDA (D\u00e9bito Direto Autorizado) para todas as contas banc\u00e1rias ativas",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * 1-5",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "DDA Daily Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dda_daily_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_dda": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncDda",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar DDA",
            "description": "Busca boletos via Open Banking/CNAB"
          }
        }
      }
    ]
  }
}