{
  "name": "ConsultaLog",
  "type": "object",
  "properties": {
    "servico": {
      "type": "string",
      "enum": [
        "cpf",
        "cnpj",
        "veiculo",
        "cep"
      ]
    },
    "documento": {
      "type": "string"
    },
    "provedor": {
      "type": "string"
    },
    "usuario": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro",
        "nao_encontrado"
      ],
      "default": "sucesso"
    },
    "tempo_resposta_ms": {
      "type": "number",
      "default": 0
    },
    "erro_detalhe": {
      "type": "string"
    },
    "campos_atualizados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cliente_id": {
      "type": "string"
    }
  },
  "required": [
    "servico"
  ]
}