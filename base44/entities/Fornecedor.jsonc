{
  "name": "Fornecedor",
  "type": "object",
  "properties": {
    "nome_fantasia": {
      "type": "string"
    },
    "razao_social": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "pecas",
        "servicos",
        "utilidades",
        "equipamentos",
        "outros"
      ],
      "default": "pecas"
    },
    "contato_nome": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "endereco": {
      "type": "string"
    },
    "condicao_pagamento": {
      "type": "string"
    },
    "prazo_medio_dias": {
      "type": "number"
    },
    "limite_credito": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "nome_fantasia"
  ]
}