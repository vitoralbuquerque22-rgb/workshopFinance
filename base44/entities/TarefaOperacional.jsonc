{
  "name": "TarefaOperacional",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "tarefa",
        "manutencao",
        "limpeza",
        "inspecao",
        "vencimento",
        "reuniao",
        "outro"
      ],
      "default": "tarefa",
      "description": "Categoria da tarefa operacional"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media"
    },
    "data_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data em que a tarefa deve ser executada"
    },
    "hora_prevista": {
      "type": "string",
      "description": "Hora prevista (HH:MM), opcional"
    },
    "responsavel_id": {
      "type": "string",
      "description": "Colaborador respons\u00e1vel pela execu\u00e7\u00e3o"
    },
    "responsavel_nome": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "description": "Itens de verifica\u00e7\u00e3o da tarefa/rotina",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "concluido": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "recorrencia": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o de recorr\u00eancia. Quando ativa, esta tarefa \u00e9 um MODELO (rotina) que gera ocorr\u00eancias automaticamente.",
      "properties": {
        "ativa": {
          "type": "boolean",
          "default": false
        },
        "frequencia": {
          "type": "string",
          "enum": [
            "diaria",
            "semanal",
            "quinzenal",
            "mensal"
          ],
          "default": "semanal"
        },
        "intervalo": {
          "type": "number",
          "default": 1,
          "description": "A cada N per\u00edodos (ex: a cada 2 semanas)"
        },
        "dias_semana": {
          "type": "array",
          "description": "Dias da semana (0=Dom..6=S\u00e1b) quando frequ\u00eancia = semanal",
          "items": {
            "type": "number"
          }
        },
        "proxima_geracao": {
          "type": "string",
          "format": "date",
          "description": "Pr\u00f3xima data em que o gerador deve criar uma ocorr\u00eancia desta rotina"
        }
      }
    },
    "modelo_id": {
      "type": "string",
      "description": "Se preenchido, esta tarefa foi gerada a partir de uma rotina (TarefaOperacional modelo)"
    },
    "referencia": {
      "type": "object",
      "description": "V\u00ednculo opcional a um vencimento de patrim\u00f4nio/frota",
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "patrimonio",
            "frota",
            "manual"
          ],
          "default": "manual"
        },
        "referencia_id": {
          "type": "string"
        },
        "descricao": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "concluida",
        "cancelada"
      ],
      "default": "pendente"
    },
    "concluida_em": {
      "type": "string",
      "format": "date-time"
    },
    "concluida_por_nome": {
      "type": "string"
    },
    "filial_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "titulo"
  ]
}