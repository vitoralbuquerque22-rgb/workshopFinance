{
  "name": "Marca",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da marca/fabricante da pe\u00e7a (ex: Bosch, NGK)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "nome"
  ]
}