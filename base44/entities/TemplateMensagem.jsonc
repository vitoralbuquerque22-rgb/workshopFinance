{
  "name": "TemplateMensagem",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome amig\u00e1vel do template (ex: P\u00f3s-venda 7 dias)"
    },
    "descricao": {
      "type": "string"
    },
    "evento": {
      "type": "string",
      "enum": [
        "manual",
        "os_finalizada",
        "orcamento_enviado",
        "orcamento_sem_resposta",
        "so_perguntou",
        "os_etapa",
        "lead_novo",
        "pos_venda",
        "lembrete_retorno"
      ],
      "default": "manual",
      "description": "Gatilho que dispara este template. 'manual' = usado apenas em agendamento avulso."
    },
    "etapa_os": {
      "type": "string",
      "description": "Quando evento = os_etapa, qual etapa da OS dispara (ex: execucao, entrega)"
    },
    "atraso_valor": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de tempo de atraso ap\u00f3s o gatilho (0 = imediato)"
    },
    "atraso_unidade": {
      "type": "string",
      "enum": [
        "minutos",
        "horas",
        "dias"
      ],
      "default": "dias"
    },
    "canal": {
      "type": "string",
      "enum": [
        "whatsapp",
        "instagram",
        "messenger",
        "email",
        "sms",
        "auto"
      ],
      "default": "auto",
      "description": "auto = usa o mesmo canal da conversa do cliente"
    },
    "texto": {
      "type": "string",
      "description": "Corpo da mensagem. Suporta vari\u00e1veis: {cliente}, {os_numero}, {veiculo}, {placa}, {valor}, {consultor}, {oficina}"
    },
    "midia_url": {
      "type": "string",
      "description": "URL opcional de imagem/v\u00eddeo/arquivo a enviar junto"
    },
    "midia_tipo": {
      "type": "string",
      "enum": [
        "imagem",
        "video",
        "arquivo"
      ]
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se false, o gatilho n\u00e3o agenda este template"
    },
    "empresa_id": {
      "type": "string"
    },
    "filial_id": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "texto"
  ]
}