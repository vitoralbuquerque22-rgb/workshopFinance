{
  "name": "AprovacaoOrcamento",
  "type": "object",
  "properties": {
    "ordem_servico_id": {
      "type": "string"
    },
    "os_numero": {
      "type": "string"
    },
    "conversa_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "veiculo_placa": {
      "type": "string"
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "token": {
      "type": "string",
      "description": "Token \u00fanico do link p\u00fablico de aprova\u00e7\u00e3o"
    },
    "canal": {
      "type": "string",
      "enum": [
        "whatsapp",
        "instagram",
        "messenger",
        "email",
        "site",
        "telegram",
        "sms",
        "google_business",
        "interno"
      ],
      "default": "whatsapp"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "reprovado",
        "expirado"
      ],
      "default": "pendente"
    },
    "enviado_por_id": {
      "type": "string"
    },
    "enviado_por_nome": {
      "type": "string"
    },
    "enviado_em": {
      "type": "string",
      "format": "date-time"
    },
    "respondido_em": {
      "type": "string",
      "format": "date-time"
    },
    "assinatura_nome": {
      "type": "string",
      "description": "Nome digitado pelo cliente como assinatura eletr\u00f4nica"
    },
    "assinatura_ip": {
      "type": "string"
    },
    "assinatura_user_agent": {
      "type": "string"
    },
    "motivo_reprovacao": {
      "type": "string"
    },
    "snapshot_itens": {
      "type": "array",
      "description": "C\u00f3pia dos itens do or\u00e7amento no momento do envio",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "required": [
    "ordem_servico_id",
    "token"
  ]
}