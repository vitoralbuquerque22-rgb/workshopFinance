{
  "name": "ConfigAutomacao",
  "type": "object",
  "properties": {
    "respeitar_horario_comercial": {
      "type": "boolean",
      "default": true,
      "description": "Se ativo, mensagens agendadas s\u00f3 s\u00e3o disparadas dentro do hor\u00e1rio comercial; fora dele ficam pendentes at\u00e9 a pr\u00f3xima janela."
    },
    "horario_inicio": {
      "type": "string",
      "default": "08:00",
      "description": "In\u00edcio da janela de disparo (HH:MM, fuso America/Sao_Paulo)"
    },
    "horario_fim": {
      "type": "string",
      "default": "20:00",
      "description": "Fim da janela de disparo (HH:MM, fuso America/Sao_Paulo)"
    },
    "disparar_fim_de_semana": {
      "type": "boolean",
      "default": false,
      "description": "Se falso, s\u00e1bados e domingos n\u00e3o disparam (mensagens ficam pendentes at\u00e9 segunda)."
    },
    "limite_por_contato_dia": {
      "type": "number",
      "default": 3,
      "description": "M\u00e1ximo de mensagens autom\u00e1ticas por contato/conversa em 24h (anti-spam). 0 = sem limite."
    },
    "dedup_horas": {
      "type": "number",
      "default": 24,
      "description": "Janela (horas) em que uma mensagem autom\u00e1tica id\u00eantica ao mesmo contato n\u00e3o \u00e9 reenviada. 0 = desligado."
    }
  },
  "required": []
}